<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>oculus_reader</name>
  <version>1.0.0</version>
  <description>
    Read poses and button state from Meta Quest controllers, and bridge them
    to ROS 2 as TF + a Cartesian velocity command for teleop / data collection.
  </description>

  <maintainer email="mario.prats@picknik.ai">Mario Prats</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>moveit_pro_controllers_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
